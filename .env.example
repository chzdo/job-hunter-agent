# =======================================================
# 1. AUTO-APPLY LOGIN CREDENTIALS
# =======================================================
# LinkedIn Credentials (for zero-human-intervention Easy Apply)
LINKEDIN_EMAIL=your_linkedin_email@gmail.com
LINKEDIN_PASSWORD=your_linkedin_password

# Indeed Credentials (optional, for Indeed Apply)
INDEED_EMAIL=your_indeed_email@gmail.com
INDEED_PASSWORD=your_indeed_password

# =======================================================
# 2. FREE EMAIL NOTIFICATIONS
# =======================================================
# Recipient to receive cycle summary reports
EMAIL_RECIPIENT=chido.nduaguibe@gmail.com

# OPTION A: Free Gmail / Outlook SMTP
# For Gmail: Use a 16-character Google App Password (not your normal Gmail password)
# Generated from: https://myaccount.google.com/apppasswords
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_google_app_password

# OPTION B: Free Resend API (Alternative to SMTP)
# Free 3,000 emails/month from https://resend.com
RESEND_API_KEY=
